# Foundry
cache/
out/
broadcast/
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Logs
.logs/
*.log

# Environment and secrets
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# JavaScript
node_modules/

# Build artifacts
artifacts/
coverage/
dist/
build/

# Local ignore files
.ignore/

# Sentinel research datasets (keep locally; do not push large data files)
data/real/*.csv
data/real/*.json
data/real/*.jsonl
data/real/*:Zone.Identifier
data/processed/*.csv
data/processed/*.json
reports/*.csv

# Synthetic Sentinel experiment outputs (generated locally)
data/synthetic/*.csv
data/synthetic/*.json

# Generated synthetic datasets and split files
data/synthetic/*.csv
data/synthetic/*.json
data/synthetic/splits/*.csv
data/synthetic/splits/*.json

# Locally trained models and generated experiment reports
models/*
reports/*.json
reports/*.joblib
reports/*.png
reports/*.pdf
data/experimental/real_background/*.csv
data/experimental/real_background/*.json
data/experimental/real_background/splits/*.csv
data/experimental/real_background/splits/*.json

# Nested E1 synthetic experiment splits
data/synthetic/e1_splits/*.csv
data/synthetic/e1_splits/*.json

# Local backup of the experimental benchmark generator
scripts/generate_real_background_benchmark.py.bak

# Generated experiment outputs; keep the human-readable submission summary
reports/**/*.csv
reports/**/*.json
reports/**/*.joblib
!reports/real_background_benchmark/SUBMISSION_RESULTS.md
